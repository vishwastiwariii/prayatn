# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL connection string (used by Prisma and the API)
DATABASE_URL=postgresql://recovery:recovery@localhost:5442/recovery_desk

# Redis connection string (used by the API; queues/workers in later phases)
REDIS_URL=redis://localhost:6389

# API server
API_PORT=4000
API_HOST=0.0.0.0

# Web server
WEB_PORT=3000

# Browser-exposed API base URL for the Next.js app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGIN=http://localhost:3000

# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Phase 12: AI (customer messages, merchant explanations, unknown-failure
# suggestions). Optional — with neither key set, Recovery Desk runs entirely
# on deterministic fallback templates; nothing else in the app depends on AI.
#
# Set ONE of these:
#
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini          # optional, any Chat Completions model with structured-output support
# OPENAI_BASE_URL=                  # optional, e.g. an Azure OpenAI / proxy endpoint
#
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5     # optional
#
# If both are set, OpenAI is used by default. Pin one explicitly with:
# AI_PROVIDER=openai   (or) AI_PROVIDER=anthropic
