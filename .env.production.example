# Recovery Desk — production environment (Phase 14 §7).
# Copy to .env.production, fill in real values, pass with --env-file.
# The API refuses to start if any of the required values below is missing.

# --- database / redis -------------------------------------------------------
POSTGRES_USER=recovery_app
POSTGRES_PASSWORD=            # required
POSTGRES_DB=recovery_desk
DATABASE_URL=postgresql://recovery_app:PASSWORD@postgres:5432/recovery_desk
REDIS_PASSWORD=               # required
REDIS_URL=redis://:PASSWORD@redis:6379

# --- security ---------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
AUTH_ENABLED=true
ADMIN_API_KEY=                # required — admin operations
OPERATOR_API_KEY=             # required — day-to-day operator + dashboard
DEMO_API_KEY=                 # optional — demo control plane only
CORS_ORIGIN=https://recovery.example.com   # must not be localhost in production
NEXT_PUBLIC_API_URL=https://api.recovery.example.com

# --- recovery policy --------------------------------------------------------
MAX_ATTEMPTS=3
MAX_MESSAGES_PER_DAY=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8

# --- circuit breaker --------------------------------------------------------
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_FAILURE_WINDOW=60
CIRCUIT_COOLDOWN=30

# --- worker -----------------------------------------------------------------
RECOVERY_WORKER_CONCURRENCY=4
JOB_TIMEOUT_MS=30000

# --- AI (optional; without it the system uses deterministic fallbacks) ------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LOG_LEVEL=info
